# =====================================================================
#  SOC Lab — secrets / API keys (local bootstrap staging)
#  Commit THIS file (.env.example). Copy to .env and fill real values.
#  NEVER commit .env. Values land in GCP Secret Manager later.
#
#    cp .env.example .env   &&   edit .env
# =====================================================================

# ---- Access plane (Tailscale) ----
# Tailscale admin > Settings > Keys > Generate auth key:
#   Reusable ON · Ephemeral ON · Tags: tag:soc-lab
# Consumed as TF_VAR_ts_authkey at apply time (see the Increment 2 steps).
TS_AUTHKEY=

# ---- Threat-intel enrichment (Cortex analyzers) ----
VT_API_KEY=                       # virustotal.com  (free tier)
ABUSEIPDB_API_KEY=                # abuseipdb.com   (free tier)

# ---- AI triage — pick ONE backend ----
AI_BACKEND=anthropic              # anthropic | ollama
# Anthropic-hosted Claude:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# ...or local Ollama (set AI_BACKEND=ollama, leave ANTHROPIC_API_KEY blank):
OLLAMA_MODEL=llama3.1

# ---- Notifications (optional, deferrable) ----
SLACK_WEBHOOK_URL=
# MATTERMOST_WEBHOOK_URL=

# ---- Lab service creds (recommend: let Terraform generate these) ----
# Leave blank — random_password + Secret Manager will populate them.
# Only set manually if you want fixed values for local testing.
SAMBA_ADMIN_PASSWORD=
VYOS_API_KEY=
