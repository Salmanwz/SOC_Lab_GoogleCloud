#!/usr/bin/env bash
set -euo pipefail

# 1. Enable IP forwarding — required for a Tailscale subnet router.
cat >/etc/sysctl.d/99-tailscale.conf <<'EOF'
net.ipv4.ip_forward = 1
net.ipv6.conf.all.forwarding = 1
EOF
sysctl -p /etc/sysctl.d/99-tailscale.conf

# 2. Make sure curl is present (egress goes out via Cloud NAT).
export DEBIAN_FRONTEND=noninteractive
apt-get -o DPkg::Lock::Timeout=180 update -y
apt-get -o DPkg::Lock::Timeout=180 install -y curl

# 3. Install Tailscale.
curl -fsSL https://tailscale.com/install.sh | sh

# 4. Join the tailnet as a subnet router advertising the VPC.
tailscale up \
  --authkey="${ts_authkey}" \
  --advertise-routes="${advertise_routes}" \
  --hostname="${hostname}" \
  --ssh \
  --accept-dns=false
